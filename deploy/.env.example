# Copie para .env e preencha. O .env NÃO vai para o git.
#   cp deploy/.env.example deploy/.env

# Senha do painel. Segunda camada: o login de verdade é o da Cloudflare, na frente.
# Gere uma longa:  openssl rand -base64 32
LEADPIPE_UI_TOKEN=

# Token do túnel, copiado do painel da Cloudflare quando você cria o tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# Fuso do servidor. Deixe no horário dos leads (Ohio = America/New_York):
# a fila do dia e os relatórios usam a data local do processo.
TZ=America/New_York

# Domínio onde os heros são publicados. Sem isso eles ficam só locais.
LEADPIPE_HERO_DOMAIN=

# Entram nos rascunhos dos toques.
LEADPIPE_SENDER_NAME=
LEADPIPE_SENDER_PHONE=
LEADPIPE_VIDEO_URL=
